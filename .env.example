# ─────────────────────────────────────────────────────────────
# Environment template. Copy to .env.local and fill in real values.
# .env.local is git-ignored; this example file is committed.
# ─────────────────────────────────────────────────────────────

# Project URL from Supabase → Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Client-safe key (anon or the new publishable key). Safe for the browser;
# it can only do what your Row Level Security policies allow.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: new-format publishable key, if you use it instead of the JWT.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ⚠️  SECRET. Server-side ONLY. Never prefix with VITE_, never commit the
# real value, never import from client code - it bypasses all RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-KEEP-SECRET

# ─────────────────────────────────────────────────────────────
# Supabase Edge Function secrets (guest-checkout)
# Set these in Supabase, not in Vercel and never in the browser:
#   npx supabase secrets set --project-ref <project-ref> \
#     RESEND_API_KEY=... \
#     SITE_URL=https://casanova-books.com \
#     ALLOWED_ORIGIN=https://casanova-books.com
# RESEND_API_KEY is required for the branded welcome email.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
SITE_URL=https://casanova-books.com
ALLOWED_ORIGIN=https://casanova-books.com

# ─────────────────────────────────────────────────────────────
# Support ticket email loop (support-inquiry / support-mail / support-inbound)
# Supabase secrets, same setter as above:
#   SUPPORT_REPLY_DOMAIN   the inbound subdomain (e.g. support.casanova-books.com)
#   SUPPORT_INBOUND_SECRET a long random string; the mail provider sends it as
#                          the x-support-inbound-secret header
#   RESEND_FROM            optional display sender, defaults to the no-reply box
#   TURNSTILE_SECRET_KEY   required to enforce CAPTCHA on guest submissions
# The provider webhook points at:
#   https://<project-ref>.supabase.co/functions/v1/support-inbound
# Reply-To becomes support+INQ-YYYY-NNNN@SUPPORT_REPLY_DOMAIN; the ticket
# number is also in the subject, so either header can be matched.
# ─────────────────────────────────────────────────────────────
SUPPORT_REPLY_DOMAIN=support.casanova-books.com
SUPPORT_INBOUND_SECRET=generate-a-long-random-string
RESEND_FROM="Casanova Books <no-reply@casanova-books.com>"

# ─────────────────────────────────────────────────────────────
# Login protection (Vercel Edge Function /auth/login)
# ─────────────────────────────────────────────────────────────

# Public Turnstile site key. Safe to ship to the browser.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server-only settings. Add these in the Vercel project environment for
# Production and Preview; they are read inside the Edge Function only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Optional, recommended: makes hashed Redis keys non-reversible without
# this server-only value.
RATE_LIMIT_PEPPER=generate-a-long-random-string
