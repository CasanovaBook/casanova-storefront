# Copy to `android/keystore.properties` and fill in. That file is git-ignored;
# this example is not, so nothing secret may ever be written into it.
#
# Without keystore.properties, `assembleRelease` falls back to the debug key and
# the resulting bundle is rejected by the Play Store. That is deliberate: a
# release nobody configured should fail at the store rather than be signed with
# a key that is published in the React Native template and is therefore known to
# everyone.
#
# Losing the keystore this points at loses the ability to ever publish an update
# to the app. It is not recoverable from Google, and on Play App Signing the
# upload key can be reset but the app signing key cannot. Keep it somewhere that
# survives the machine it was generated on.

# Paths are resolved against `android/` (the Gradle root project), not against
# `android/app/`, so `release.keystore` here means `android/release.keystore`.
storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
