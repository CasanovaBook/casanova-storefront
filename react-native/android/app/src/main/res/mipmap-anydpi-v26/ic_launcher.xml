<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon, API 26+. The launcher supplies the mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Monochrome layer, API 33+. Without it the icon renders as a grey
         box in Android's themed-icon mode, which on a home screen full of
         correctly themed icons looks broken rather than neutral. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
