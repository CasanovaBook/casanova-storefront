<?xml version="1.0" encoding="utf-8"?>
<!--
  Round launcher icon, API 26+.

  Identical to `ic_launcher.xml` on purpose. From API 26 the launcher applies
  its own mask to an adaptive icon, so a separate "round" asset is a leftover
  of the pre-adaptive era — but `android:roundIcon` is still read by enough
  launchers that omitting it means those devices fall back to a default icon
  instead of ours.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
